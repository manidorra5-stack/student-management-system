pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = "sms_pr_${BUILD_NUMBER}"
        WEB_PORT = "5001"
        APP_VERSION = "pr-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            when {
                anyOf {
                    changeRequest target: 'dev'
                    expression { return env.CHANGE_TARGET == null }
                }
            }
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            when {
                anyOf {
                    changeRequest target: 'dev'
                    expression { return env.CHANGE_TARGET == null }
                }
            }
            steps {
                bat '''
                if not exist artifacts mkdir artifacts
                docker --version
                docker compose version
                echo Target Branch: %CHANGE_TARGET%
                echo Source Branch: %CHANGE_BRANCH%
                '''
            }
        }

        stage('Build') {
            when {
                anyOf {
                    changeRequest target: 'dev'
                    expression { return env.CHANGE_TARGET == null }
                }
            }
            steps {
                bat 'docker compose build'
                bat 'docker run --rm -v "%WORKSPACE%/artifacts:/app/artifacts" student-management-system:%APP_VERSION% pytest -v --junitxml=/app/artifacts/pr_unit_tests.xml'
            }
        }

        stage('Run (Docker)') {
            when {
                anyOf {
                    changeRequest target: 'dev'
                    expression { return env.CHANGE_TARGET == null }
                }
            }
            steps {
                bat 'docker compose up -d'
            }
        }

        stage('Smoke Test') {
            when {
                anyOf {
                    changeRequest target: 'dev'
                    expression { return env.CHANGE_TARGET == null }
                }
            }
            steps {
                bat 'docker run --rm --network %COMPOSE_PROJECT_NAME%_sms_network -v "%WORKSPACE%/scripts:/app/scripts" -v "%WORKSPACE%/artifacts:/app/artifacts" student-management-system:%APP_VERSION% python /app/scripts/smoke_test.py --url http://web:5000 --report /app/artifacts/pr_smoke_report.json'
            }
        }

        stage('Archive Artifacts') {
            when {
                anyOf {
                    changeRequest target: 'dev'
                    expression { return env.CHANGE_TARGET == null }
                }
            }
            steps {
                bat '''
                echo Pipeline: sms-pr-multibranch > artifacts/pr_pipeline_report.txt
                echo Build: #%BUILD_NUMBER% >> artifacts/pr_pipeline_report.txt
                echo PR ID: %CHANGE_ID% (%CHANGE_BRANCH% -> %CHANGE_TARGET%) >> artifacts/pr_pipeline_report.txt
                echo Status: PASSED >> artifacts/pr_pipeline_report.txt
                '''
                archiveArtifacts artifacts: 'artifacts/*.json, artifacts/*.xml, artifacts/*.txt', allowEmptyArchive: false
            }
        }
    }

    post {
        always {
            bat 'docker compose down -v'
        }
    }
}